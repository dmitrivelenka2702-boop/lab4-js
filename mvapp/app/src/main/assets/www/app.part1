явиться після перших витрат.</div>';let d=DATA.daily||[],mx=Math.max(1,...d.map(x=>x.amount));dailyChart.innerHTML=d.length?d.map(x=>`<div class="colwrap" title="${esc(x.date)}: ${money(x.amount)}"><div class="col" style="height:${Math.max(2,x.amount/mx*100)}%"></div><div class="collabel">${esc(x.date.slice(5))}</div></div>`).join(''):'<div class="empty">Немає даних.</div>'}
function renderSettings(){let d=DATA.dashboard||{};if(document.getElementById('budgetInput')&&!document.getElementById('budgetInput').matches(':focus'))budgetInput.value=d.budget||'';if(document.getElementById('accessStatus')){accessStatus.innerHTML=DATA.notificationAccess?'<span class="ok">● Доступ увімкнено — автооблік працює</span>':'<span class="warn">● Доступ ще не надано</span>'}}
function openAccess(){Android.openNotificationAccess();setTimeout(()=>refreshAll(),1000)}
function saveBudget(){Android.setBudget(Number(budgetInput.value||0));setTimeout(refreshAll,150)}
function openExpense(id){let t=id?DATA.transactions.find(x=>x.id===id):null;modalContent.innerHTML=`<div class="form"><h3>${t?'Редагувати витрату':'Нова витрата'}</h3><div class="field"><label>Сума, грн</label><input id="fAmount" type="number" inputmode="decimal" value="${t?esc(t.amount):''}" placeholder="0"></div><div class="field"><label>Категорія</label><select id="fCat">${CATS.map(c=>`<option ${t&&t.category===c?'selected':''}>${esc(c)}</option>`).join('')}</select></div><div class="field"><label>Магазин / одержувач</label><input id="fMerchant" value="${t?esc(t.merchant):''}" placeholder="Наприклад АТБ"></div><div class="field"><label>Коментар</label><textarea id="fNote" placeholder="Необов’язково">${t?esc(t.note):''}</textarea></div><div class="actions"><button class="primary" onclick="saveExpense(${t?t.id:0})">${t?'Зберегти':'Додати'}</button>${t?`<button class="secondary danger" onclick="deleteExpense(${t.id})">Видалити</button>`:''}</div></div>`;openModal()}
function saveExpense(id){let amount=Number(fAmount.value);if(!amount||amount<=0){alert('Введи суму');return}if(id)Android.updateExpense(id,amount,fCat.value,fMerchant.value,fNote.value);else Android.addExpense(amount,fCat.value,fMerchant.value,fNote.value);closeModal();setTimeout(refreshAll,150)}
function deleteExpense(id){if(confirm('Видалити цю витрату?')){Android.deleteExpense(id);closeModal();setTimeout(refreshAll,150)}}
function renderGoals(){if(!DATA.goals.length){goalsList.innerHTML='<div class="empty">Додай велику покупку, на яку хочеш відкладати.</div>';return}goalsList.innerHTML=DATA.goals.map(g=>{let pct=Math.min(100,Math.round((g.saved||0)/(g.target||1)*100));return `<div class="item"><div class="cat">🎯</div><div class="item-main"><b>${esc(g.title)}</b><div class="meta">${money(g.saved)} із ${money(g.target)} · ${pct}%</div><div class="goalbar"><i style="width:${pct}%"></i></div></div><div class="item-actions"><button class="mini-btn" onclick="event.stopPropagation();editGoal(${g.id})">✎</button><button class="mini-btn" onclick="event.stopPropagation();delGoal(${g.id})">×</button></div></div>`}).join('')}
function openGoal(){modalContent.innerHTML=`<div class="form"><h3>Нова велика покупка</h3><div class="field"><label>Що хочеш купити</label><input id="gTitle" placeholder="Наприклад камера"></div><div class="field"><label>Потрібна сума</label><input id="gTarget" type="number" inputmode="decimal"></div><div class="field"><label>Вже відкладено</label><input id="gSaved" type="number" inputmode="decimal" value="0"></div><button c