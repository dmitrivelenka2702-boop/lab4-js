let DATA={dashboard:{},transactions:[],categories:[],daily:[],goals:[],debts:[],notificationAccess:false};
const CATS=['Продукти','Дитина','Дім','Авто','Краса / побут','Здоров’я','Одяг','Транспорт','Кафе / ресторани','Техніка / покупки','Зв’язок / інтернет','Комунальні','Розваги','Інше'];
const ICONS={'Продукти':'🛒','Дитина':'🧸','Дім':'🏠','Авто':'🚗','Краса / побут':'✨','Здоров’я':'💊','Одяг':'👗','Транспорт':'🚌','Кафе / ресторани':'☕','Техніка / покупки':'📦','Зв’язок / інтернет':'📱','Комунальні':'💡','Розваги':'🎬','Інше':'₴'};
const money=n=>new Intl.NumberFormat('uk-UA',{maximumFractionDigits:2}).format(Number(n||0))+' ₴';
const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
const fmtDate=ms=>new Date(ms).toLocaleString('uk-UA',{day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
function getData(){try{DATA=JSON.parse(Android.getData());}catch(e){console.log(e)}return DATA}
window.refreshAll=function(){getData();renderAll()}
document.addEventListener('DOMContentLoaded',()=>{document.querySelectorAll('.nav').forEach(b=>b.onclick=()=>showPage(b.dataset.target));document.getElementById('quickAdd').onclick=()=>openExpense();refreshAll();});
function showPage(name){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.dataset.page===name));document.querySelectorAll('.nav').forEach(b=>b.classList.toggle('active',b.dataset.target===name));if(name==='settings')renderSettings();}
function renderAll(){renderHome();renderTransactions();renderStats();renderGoals();renderDebts();renderSettings();}
function renderHome(){let d=DATA.dashboard||{};monthSpent.textContent=money(d.month);todaySpent.textContent=money(d.today);monthCount.textContent=Math.round(d.count||0);let b=Number(d.budget||0),m=Number(d.month||0);if(b>0){let rem=Math.max(0,b-m),pct=Math.min(100,Math.round(m/b*100));budgetText.textContent='Залишок '+money(rem);budgetPct.textContent=pct+'%';budgetBar.style.width=pct+'%'}else{budgetText.textContent='Бюджет не задано';budgetPct.textContent='—';budgetBar.style.width='0'};accessBanner.classList.toggle('hidden',!!DATA.notificationAccess);recentList.innerHTML=listHtml(DATA.transactions.slice(0,6),true)}
function listHtml(items,compact=false){if(!items.length)return '<div class="empty">Поки що витрат немає.</div>';return items.map(t=>`<div class="item" onclick="${compact?`openExpense(${t.id})`:`openExpense(${t.id})`}"><div class="cat">${ICONS[t.category]||'₴'}</div><div class="item-main"><b>${esc(t.merchant||t.note||'Витрата')}</b><div class="meta">${esc(t.category)} · ${fmtDate(t.createdAt)} ${t.bank?`· <span class="bank-badge">${esc(t.bank)}</span>`:''}${t.source==='notification'?'<span class="source">авто</span>':''}</div></div><div class="amount">−${money(t.amount)}</div></div>`).join('')}
function renderTransactions(){let q=(document.getElementById('searchInput')?.value||'').toLowerCase().trim();let a=DATA.transactions.filter(t=>!q||[t.merchant,t.note,t.category,t.bank].join(' ').toLowerCase().includes(q));transactionsList.innerHTML=listHtml(a)}
function renderStats(){let max=Math.max(1,...DATA.categories.map(x=>x.amount));categoryChart.innerHTML=DATA.categories.length?DATA.categories.map(x=>`<div class="barrow"><div class="barlabel"><span>${esc(x.category)}</span><b>${money(x.amount)}</b></div><div class="bartrack"><div class="barfill" style="width:${Math.max(2,x.amount/max*100)}%"></div></div></div>`).join(''):'<div class="empty">Статистика з’