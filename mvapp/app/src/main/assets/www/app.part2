lass="primary wide" onclick="saveGoal()">Додати ціль</button></div>`;openModal()}
function saveGoal(){if(!gTitle.value.trim()||Number(gTarget.value)<=0)return alert('Заповни назву і суму');Android.addGoal(gTitle.value.trim(),Number(gTarget.value),Number(gSaved.value||0));closeModal();setTimeout(refreshAll,150)}
function editGoal(id){let g=DATA.goals.find(x=>x.id===id);let v=prompt('Скільки вже відкладено?',g.saved);if(v!==null&&Number(v)>=0){Android.updateGoal(id,Number(v));setTimeout(refreshAll,150)}}
function delGoal(id){if(confirm('Видалити ціль?')){Android.deleteGoal(id);setTimeout(refreshAll,150)}}
function renderDebts(){if(!DATA.debts.length){debtsList.innerHTML='<div class="empty">Боргів поки немає.</div>';return}debtsList.innerHTML=DATA.debts.map(d=>`<div class="item ${d.paid?'paid':''}"><div class="cat">${d.direction==='owe_me'?'↙':'↗'}</div><div class="item-main"><b>${esc(d.person)}</b><div class="meta">${d.direction==='owe_me'?'Мені винні':'Я винна'} · ${esc(d.note||'')}</div></div><div class="amount">${money(d.amount)}</div><div class="item-actions"><button class="mini-btn" onclick="Android.toggleDebt(${d.id},${!d.paid});setTimeout(refreshAll,120)">${d.paid?'↶':'✓'}</button><button class="mini-btn" onclick="Android.deleteDebt(${d.id});setTimeout(refreshAll,120)">×</button></div></div>`).join('')}
function openDebt(){modalContent.innerHTML=`<div class="form"><h3>Новий борг</h3><div class="field"><label>Хто</label><input id="dPerson" placeholder="Ім’я"></div><div class="field"><label>Сума</label><input id="dAmount" type="number" inputmode="decimal"></div><div class="field"><label>Тип</label><select id="dDir"><option value="owe_me">Мені винні</option><option value="i_owe">Я винна</option></select></div><div class="field"><label>Коментар</label><input id="dNote" placeholder="За що"></div><button class="primary wide" onclick="saveDebt()">Додати</button></div>`;openModal()}
function saveDebt(){if(!dPerson.value.trim()||Number(dAmount.value)<=0)return alert('Заповни ім’я і суму');Android.addDebt(dPerson.value.trim(),Number(dAmount.value),dDir.value,dNote.value);closeModal();setTimeout(refreshAll,150)}
function openModal(){modal.classList.remove('hidden')}function closeModal(){modal.classList.add('hidden')}
window.handleVoice=function(text){let m=String(text).replace(',','.').match(/(\d+(?:\.\d{1,2})?)/);if(!m)return alert('Не почула суму. Спробуй: «350 гривень аптека»');let amount=Number(m[1]);let note=String(text).replace(m[0],'').replace(/грив(ень|ні|ня)?/gi,'').trim();let cat=guessCat(note);Android.addExpense(amount,cat,note,note);setTimeout(refreshAll,180);alert('Додано: '+money(amount)+' · '+cat)}
function guessCat(s){let x=s.toLowerCase();if(/аптек|лікар|мед/.test(x))return'Здоров’я';if(/атб|сільпо|маркет|продукт/.test(x))return'Продукти';if(/бенз|азс|wog|okko/.test(x))return'Авто';if(/ева|eva|космет|побут/.test(x))return'Краса / побут';if(/дит|підгуз|мал/.test(x))return'Дитина';if(/кафе|кава|ресторан|піца/.test(x))return'Кафе / ресторани';return'Інше'}
